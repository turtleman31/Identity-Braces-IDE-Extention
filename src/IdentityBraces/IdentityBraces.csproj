    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!--
    Stamp a unique version into the manifest on every build.

    Visual Studio keys an installed extension on Identity + Version, so installing a VSIX
    over an existing one with the SAME version is a no-op: the old files stay on disk and the
    cached MEF composition keeps serving the old assembly. Shipping several different builds
    all stamped 1.0.0 means the user silently keeps running the first one.

    Build number is days since 2020-01-01, revision is minutes since midnight UTC. Both stay
    well inside the 65535 limit each version field allows, and together they change on every
    build a person could realistically make.
  -->
  <Target Name="StampVsixVersion">
    <PropertyGroup>
      <_IbDays>$([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2020-01-01'))).Days)</_IbDays>
      <_IbMinutes>$([System.Convert]::ToInt32($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))</_IbMinutes>
      <_IbVersion>$(IdentityBracesMajorMinor).$(_IbDays).$(_IbMinutes)</_IbVersion>
    </PropertyGroup>
    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\source.extension.vsixmanifest"
             Query="/vsx:PackageManifest/vsx:Metadata/vsx:Identity/@Version"
             Value="$(_IbVersion)"
             Namespaces="&lt;Namespace Prefix='vsx' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;" />
    <Message Importance="high" Text="Identity Braces VSIX version: $(_IbVersion)" />
  </Target>
