<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="IdentityBraces.794AD149-2FA0-453B-94A6-92FB7F780C71" Version="1.2.2450.592" Language="en-US" Publisher="Identity Braces" />
    <DisplayName>Identity Braces</DisplayName>
    <Description xml:space="preserve">Rainbow braces make matching pairs share a colour so code is easier to read. Identity Braces does the opposite: every brace pair gets its own colour out of 32, and a few of them develop personalities. Some cycle colour forever. Some render as a question mark. Some grow cat ears and thigh highs. Your code is not more readable. Your braces are people now.</Description>
    <Tags>braces;brackets;rainbow;colour;color;editor;classifier;adornment;fun</Tags>
  </Metadata>
  <Installation>
    <!-- 17.0 is Visual Studio 2022, 18.x is Visual Studio 2026. Both host extensions on
         .NET Framework 4.7.2, so a single build serves them. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>